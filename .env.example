# Jersey.com.bd — environment variables
# The app runs with sane defaults; copy to .env to override.
# On Render, these are set in Dashboard → Environment (see DEPLOYMENT.md).

# ---- API server (server/index.js) ----
# development | production
# NODE_ENV=production
# Port for the API server (serves /api/* and, in production, the built frontend)
PORT=8787
# REQUIRED in production — the process refuses to boot without it.
# Dev default is "admin123". Never commit the real value; set it in your host dashboard.
ADMIN_PASSWORD=change-me-in-production
# Where the JSON database lives. On Render the disk is mounted at /persist/data.
# JBD_DB_PATH=/persist/data/db.json
# Where uploaded product images are stored. Defaults to a sibling "uploads" folder
# of JBD_DB_PATH (so the same persistent disk covers them); local default is server/data/uploads.
# JBD_UPLOAD_DIR=/persist/data/uploads
# Free-delivery threshold in BDT used by the server when pricing orders
JBD_FREE_DELIVERY_THRESHOLD=2000
# Comma-separated origins allowed to call the API cross-origin (leave unset for same-origin)
# ALLOWED_ORIGINS=https://jersey.com.bd,https://www.jersey.com.bd

# ---- Frontend (optional, all have defaults) ----
# Base URL of the storefront (used for canonical links / WhatsApp share text)
VITE_SITE_URL=https://jersey.com.bd
# WhatsApp order number (international format, no +)
VITE_WHATSAPP_NUMBER=8801989454658
# Support phone number shown in header/footer/contact page
VITE_SUPPORT_PHONE=+880 1989 454 658
# Client-side free-delivery threshold shown in the cart (server is authoritative)
VITE_FREE_DELIVERY_THRESHOLD=2000
